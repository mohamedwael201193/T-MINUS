{
  "name": "@tminus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/server.test.ts src/feed-parse.test.ts src/program-status.test.ts src/lifecycle-classify.test.ts src/prestocks-catalog.test.ts src/pda.test.ts src/issuer-instruction.test.ts src/safety-gate.test.ts src/onchain-mint.test.ts",
    "test:db": "node --import tsx --test src/lease.test.ts",
    "migrate": "node --import tsx src/migrate.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.2",
    "@tminus/sdk": "workspace:*",
    "dotenv": "^16.6.1",
    "postgres": "^3.4.7",
    "tsx": "^4.20.5",
    "@tminus/keeper": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
