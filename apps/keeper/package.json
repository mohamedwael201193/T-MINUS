{
  "name": "@tminus/keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./run": "./src/run.ts"
  },
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "sim:compose": "node --import tsx scripts/sim-compose.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "@tminus/sdk": "workspace:*",
    "dotenv": "^16.6.1",
    "postgres": "^3.4.7",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
